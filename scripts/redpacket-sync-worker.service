[Unit]
Description=RedPacket Onchain ID Sync Worker
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=redpacket
Group=redpacket
WorkingDirectory=/opt/redpacket-backend
EnvironmentFile=/etc/redpacket/backend.env
ExecStart=/opt/redpacket-backend/bin/redpacket-sync-worker
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
